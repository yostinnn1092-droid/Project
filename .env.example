# ── Stake credentials (live mode only) ────────────────────────────────
# stake.us needs only the access token.
# stake.com also needs cf_clearance AND the exact User-Agent that got it.
STAKE_ACCESS_TOKEN=
STAKE_CF_CLEARANCE=
STAKE_USER_AGENT=
STAKE_BASE_URL=https://stake.us
STAKE_CURRENCY=usdt

# ── Strategy ──────────────────────────────────────────────────────────
BOT_STREAK_LENGTH=3          # run length that arms a bet
BOT_STAKE_PCT=0.01           # base stake as a fraction of bankroll
BOT_DIRECTION=follow         # follow | against
BOT_MARTINGALE_STEPS=1       # doubling steps after a loss
BOT_MARTINGALE_MULTIPLIER=2.0
BOT_RETRIGGER=new_run        # new_run | every_n
BOT_STAKE_BASE=current       # current (compounding) | session (flat)

# ── Risk guards ───────────────────────────────────────────────────────
BOT_STOP_LOSS_PCT=0.20
BOT_TAKE_PROFIT_PCT=0
BOT_MAX_STAKE_PCT=0.10
BOT_MAX_ROUNDS=0
BOT_MAX_BETS=0
BOT_MIN_STAKE=0
BOT_STAKE_PRECISION=8

# ── Runtime ───────────────────────────────────────────────────────────
BOT_PAPER_BALANCE=1000
BOT_DELAY=1.5                # seconds between coups in live mode
BOT_OBSERVE_STAKE=0          # probe stake to reveal a coup (live only!)
