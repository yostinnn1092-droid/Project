.venv/
__pycache__/
*.py[cod]
backtest.png

# Never commit credentials. Exchange keys belong in env vars or a secrets
# manager — a leaked key with trade permissions is someone else's bot.
.env
*.key
secrets.*

# Fetched market data — regenerate with fetch_stocks.py / fetch_forex.py
data/stocks_h1/
data/forex_h1/
data/gold_h1/
journal/
data/m5/
data/m1/

# Local agent tooling config (ECC install, permission overrides).
# Not project source — reinstalled per machine, never shared.
.claude/

# Generated knowledge graph (graphify). Rebuildable from source with
# /graphify — the HTML bundle alone is megabytes, and it goes stale the
# moment the code it describes changes.
graphify-out/
