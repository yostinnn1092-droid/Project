.venv/
__pycache__/
*.py[cod]
backtest.png

# Never commit credentials. Exchange keys belong in env vars or a secrets
# manager — a leaked key with trade permissions is someone else's bot.
.env
*.key
secrets.*

# Fetched market data — regenerate with fetch_stocks.py / fetch_forex.py
data/stocks_h1/
data/forex_h1/
data/gold_h1/
journal/
data/m5/
data/m1/

# Local agent tooling config (ECC install, permission overrides).
# Not project source — reinstalled per machine, never shared.
.claude/

# Generated knowledge graph (graphify). Rebuildable from source with
# /graphify — the HTML bundle alone is megabytes, and it goes stale the
# moment the code it describes changes.
graphify-out/

# Ruflo local secrets and runtime data
.env.local
.env.*.local

# Ruflo runtime state. `ruflo init` only ignored .claude-flow/{data,logs,
# sessions}, which leaves a 1.7MB SQLite swarm memory and a 548K vector store
# to be committed on the next `git add`. These are regenerated by init and are
# per-machine, so they are treated like .claude/ above: local tooling, not
# source. What IS tracked is the config a teammate needs — CLAUDE.md, the
# .mcp.json server registration, and .agents/skills/.
.claude-flow/
.swarm/
ruvector.db
*.rvf
*.rvf.lock
